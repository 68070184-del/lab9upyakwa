<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Question</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Kanit&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Kanit', sans-serif; }
    </style>
</head>
<body>
    <div class="container py-5" style="max-width: 700px;">
        <h1 class="mb-4">Questions</h1>

        <% data.forEach(row => { %>
            <div class="card mb-3 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-3"><%= row.QID %>. <%= row.Stem %></h5>

                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="<%= row.QID %>" id="<%= row.QID %>A" <%= row.Correct === "A" ? 'checked' : '' %>>
                        <label class="form-check-label" for="<%= row.QID %>A"><%= row.Alt_A %></label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="<%= row.QID %>" id="<%= row.QID %>B" <%= row.Correct === "B" ? 'checked' : '' %>>
                        <label class="form-check-label" for="<%= row.QID %>B"><%= row.Alt_B %></label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="<%= row.QID %>" id="<%= row.QID %>C" <%= row.Correct === "C" ? 'checked' : '' %>>
                        <label class="form-check-label" for="<%= row.QID %>C"><%= row.Alt_C %></label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="<%= row.QID %>" id="<%= row.QID %>D" <%= row.Correct === "D" ? 'checked' : '' %>>
                        <label class="form-check-label" for="<%= row.QID %>D"><%= row.Alt_D %></label>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>